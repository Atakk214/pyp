<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ page import="java.util.*,com.sistemapyp.model.Usuario" %><!DOCTYPE html><html lang="es"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Sistema PyP | Usuarios</title><link rel="stylesheet" href="${pageContext.request.contextPath}/estilos.css"></head><body><main class="contenedor"><header><div><span class="etiqueta">PROMOCIÓN Y PREVENCIÓN EN SALUD</span><h1>Gestión de usuarios</h1><p>Registro y seguimiento de usuarios del Sistema PyP</p></div><a class="boton" href="usuarios?accion=nuevo">+ Nuevo usuario</a></header><% if(request.getAttribute("error")!=null){ %><p class="error"><%= request.getAttribute("error").toString().replace("<","&lt;") %></p><% } %><section class="tarjeta"><table><thead><tr><th>Documento</th><th>Nombre</th><th>Edad</th><th>Tipo</th><th>Acciones</th></tr></thead><tbody><% List<Usuario> usuarios=(List<Usuario>)request.getAttribute("usuarios"); if(usuarios!=null)for(Usuario u:usuarios){ %><tr><td><%= esc(u.getIdUsuario()) %></td><td><%= esc(u.getNombre()) %></td><td><%= u.getEdad() %></td><td><%= esc(u.getTipoUsuario()) %></td><td class="acciones"><a href="usuarios?accion=editar&id=<%= java.net.URLEncoder.encode(u.getIdUsuario(),"UTF-8") %>">Editar</a><form method="post" action="usuarios" onsubmit="return confirm('¿Eliminar este usuario?')"><input type="hidden" name="accion" value="eliminar"><input type="hidden" name="id" value="<%= esc(u.getIdUsuario()) %>"><button type="submit" class="eliminar">Eliminar</button></form></td></tr><% } %></tbody></table><% if(usuarios==null||usuarios.isEmpty()){ %><p class="vacio">Todavía no hay usuarios registrados.</p><% } %></section></main></body></html><%! private String esc(String s){return s==null?"":s.replace("&","&amp;").replace("<","&lt;").replace(">","&gt;").replace("\"","&quot;").replace("'","&#39;");} %>