<?xml version="1.0" encoding="utf-8"?>

<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- ENCABEZADO -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <ImageButton
                android:id="@+id/btnMenu"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@android:color/transparent"
                android:src="@android:drawable/ic_menu_sort_by_size"
                android:contentDescription="Abrir menú" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Sistema PyP"
                android:textColor="#111111"
                android:textSize="20sp"
                android:textStyle="bold"
                android:gravity="center" />

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@android:drawable/ic_menu_myplaces"
                android:contentDescription="Perfil" />

        </LinearLayout>

        <!-- CONTENIDO -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Educación"
                    android:textColor="#111111"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Información para promover el cuidado y la prevención en salud."
                    android:textColor="#222222"
                    android:textSize="16sp"
                    android:layout_marginBottom="24dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Prevención en salud"
                    android:textColor="#111111"
                    android:textSize="19sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="La prevención permite identificar factores de riesgo y adoptar hábitos que contribuyan al cuidado de la salud."
                    android:textColor="#333333"
                    android:textSize="16sp"
                    android:layout_marginBottom="24dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Hábitos saludables"
                    android:textColor="#111111"
                    android:textSize="19sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Una alimentación equilibrada, actividad física, descanso adecuado y buena hidratación ayudan a mantener un estilo de vida saludable."
                    android:textColor="#333333"
                    android:textSize="16sp"
                    android:layout_marginBottom="24dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Controles de salud"
                    android:textColor="#111111"
                    android:textSize="19sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Realizar controles periódicos y consultar al personal de salud permite realizar un seguimiento oportuno."
                    android:textColor="#333333"
                    android:textSize="16sp" />

            </LinearLayout>

        </ScrollView>

    </LinearLayout>

    <!-- MENÚ LATERAL -->
    <LinearLayout
        android:id="@+id/menuLateral"
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:orientation="vertical"
        android:background="#FFFFFF"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Paciente"
            android:textColor="#111111"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="24dp" />

        <TextView
            android:id="@+id/menuSintomas"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Síntomas"
            android:textColor="#111111"
            android:textSize="17sp"
            android:gravity="center_vertical" />

        <TextView
            android:id="@+id/menuMedicamentos"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Medicamentos"
            android:textColor="#111111"
            android:textSize="17sp"
            android:gravity="center_vertical" />

        <TextView
            android:id="@+id/menuDiario"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Diario"
            android:textColor="#111111"
            android:textSize="17sp"
            android:gravity="center_vertical" />

        <TextView
            android:id="@+id/menuAlertas"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Alertas"
            android:textColor="#111111"
            android:textSize="17sp"
            android:gravity="center_vertical" />

        <TextView
            android:id="@+id/menuRecomendaciones"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Recomendaciones"
            android:textColor="#111111"
            android:textSize="17sp"
            android:gravity="center_vertical" />

        <TextView
            android:id="@+id/menuEducacion"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Educación"
            android:textColor="#111111"
            android:textSize="17sp"
            android:gravity="center_vertical" />

    </LinearLayout>

</androidx.drawerlayout.widget.DrawerLayout>
