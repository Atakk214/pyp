<?xml version="1.0" encoding="utf-8"?>

<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- CONTENIDO PRINCIPAL -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FAF8FC">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- ENCABEZADO -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="24dp">

                <ImageButton
                    android:id="@+id/btnMenu"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@android:drawable/ic_menu_sort_by_size"
                    android:contentDescription="Abrir menú"
                    android:backgroundTint="@android:color/transparent" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Sistema PyP"
                    android:textColor="#8245ED"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:gravity="center" />

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@android:drawable/ic_menu_myplaces"
                    android:contentDescription="Perfil" />

            </LinearLayout>

            <!-- TÍTULO -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Registrar síntomas"
                android:textColor="#8245ED"
                android:textSize="26sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Registra cómo te sientes para llevar un seguimiento de tu salud."
                android:textColor="#666666"
                android:textSize="14sp"
                android:layout_marginBottom="24dp" />

            <!-- SÍNTOMA -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Síntoma"
                android:textColor="#333333"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <EditText
                android:id="@+id/etSintoma"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Ej. Dolor de cabeza"
                android:textColor="#333333"
                android:textColorHint="#999999"
                android:inputType="text"
                android:padding="14dp"
                android:layout_marginBottom="18dp" />

            <!-- DESCRIPCIÓN -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Descripción"
                android:textColor="#333333"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <EditText
                android:id="@+id/etDescripcion"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:hint="Describe lo que estás sintiendo..."
                android:textColor="#333333"
                android:textColorHint="#999999"
                android:gravity="top"
                android:inputType="textMultiLine"
                android:padding="14dp"
                android:layout_marginBottom="18dp" />

            <!-- INTENSIDAD -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Intensidad del síntoma"
                android:textColor="#333333"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <RadioGroup
                android:id="@+id/rgIntensidad"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="18dp">

                <RadioButton
                    android:id="@+id/rbLeve"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:text="Leve"
                    android:textColor="#333333" />

                <RadioButton
                    android:id="@+id/rbModerado"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:text="Moderado"
                    android:textColor="#333333"
                    android:layout_marginStart="12dp" />

                <RadioButton
                    android:id="@+id/rbSevero"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:text="Severo"
                    android:textColor="#333333"
                    android:layout_marginStart="12dp" />

            </RadioGroup>

            <!-- FECHA -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Fecha del síntoma"
                android:textColor="#333333"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <EditText
                android:id="@+id/etFecha"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Selecciona una fecha"
                android:textColor="#333333"
                android:textColorHint="#999999"
                android:focusable="false"
                android:clickable="true"
                android:padding="14dp"
                android:layout_marginBottom="24dp" />

            <!-- BOTÓN -->

            <Button
                android:id="@+id/btnGuardarSintoma"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:text="GUARDAR SÍNTOMA"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:backgroundTint="#8245ED" />

        </LinearLayout>

    </ScrollView>

    <!-- MENÚ LATERAL -->

    <LinearLayout
        android:id="@+id/menuLateral"
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:orientation="vertical"
        android:background="#FFFFFF"
        android:padding="20dp">

        <!-- USUARIO -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="👤 Bienvenido paciente"
            android:textColor="#333333"
            android:textSize="18sp"
            android:textStyle="bold"
            android:padding="12dp"
            android:layout_marginBottom="20dp" />

        <!-- OPCIONES -->

        <TextView
            android:id="@+id/menuInicio"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="⌂   Inicio"
            android:textColor="#333333"
            android:textSize="16sp"
            android:gravity="center_vertical"
            android:padding="12dp" />

        <TextView
            android:id="@+id/menuSintomas"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="🩺   Síntomas"
            android:textColor="#8245ED"
            android:textSize="16sp"
            android:textStyle="bold"
            android:gravity="center_vertical"
            android:padding="12dp" />

        <TextView
            android:id="@+id/menuMedicamentos"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="💊   Medicamentos"
            android:textColor="#333333"
            android:textSize="16sp"
            android:gravity="center_vertical"
            android:padding="12dp" />

        <TextView
            android:id="@+id/menuDiario"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="📔   Diario"
            android:textColor="#333333"
            android:textSize="16sp"
            android:gravity="center_vertical"
            android:padding="12dp" />

        <TextView
            android:id="@+id/menuAlertas"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="🔔   Alertas"
            android:textColor="#333333"
            android:textSize="16sp"
            android:gravity="center_vertical"
            android:padding="12dp" />

        <TextView
            android:id="@+id/menuRecomendaciones"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="💡   Recomendaciones"
            android:textColor="#333333"
            android:textSize="16sp"
            android:gravity="center_vertical"
            android:padding="12dp" />

        <TextView
            android:id="@+id/menuEducacion"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="📚   Educación"
            android:textColor="#333333"
            android:textSize="16sp"
            android:gravity="center_vertical"
            android:padding="12dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/menuCerrarSesion"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="🚪   Cerrar sesión"
            android:textColor="#E53935"
            android:textSize="16sp"
            android:gravity="center_vertical"
            android:padding="12dp" />

    </LinearLayout>

</androidx.drawerlayout.widget.DrawerLayout>