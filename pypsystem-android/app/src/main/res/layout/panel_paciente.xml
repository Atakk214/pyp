<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sistema PyP"
            android:textSize="28sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Hola, paciente 👋"
            android:textSize="20sp"
            android:layout_marginBottom="24dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="¿Qué deseas consultar?"
            android:textSize="16sp"
            android:layout_marginBottom="16dp" />

        <Button
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="🩺  Síntomas"
            android:textSize="16sp"
            android:layout_marginBottom="12dp"
            android:backgroundTint="@color/pyp_purple" />

        <Button
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="💊  Medicamentos"
            android:textSize="16sp"
            android:layout_marginBottom="12dp"
            android:backgroundTint="@color/pyp_purple" />

        <Button
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="📔  Diario de hábitos"
            android:textSize="16sp"
            android:layout_marginBottom="12dp"
            android:backgroundTint="@color/pyp_purple" />

        <Button
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="🔔  Alertas y recordatorios"
            android:textSize="16sp"
            android:layout_marginBottom="12dp"
            android:backgroundTint="@color/pyp_purple" />

        <Button
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="💡  Recomendaciones"
            android:textSize="16sp"
            android:layout_marginBottom="12dp"
            android:backgroundTint="@color/pyp_purple" />

        <Button
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="📚  Educación"
            android:textSize="16sp"
            android:layout_marginBottom="12dp"
            android:backgroundTint="@color/pyp_purple" />

    </LinearLayout>

</ScrollView>